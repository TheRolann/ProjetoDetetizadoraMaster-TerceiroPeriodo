<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- Unidade de persistencia -->
    <persistence-unit name="detetizadora_master" transaction-type="RESOURCE_LOCAL">

        <!-- Provider JPA - Hibernate como gerenciador -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Classes mapeadas (as @Entity) - TABELAS -->
        <class>br.edu.uniamerica.projetomensal.model.Cliente</class>
        <class>br.edu.uniamerica.projetomensal.model.Funcionario</class>
        <class>br.edu.uniamerica.projetomensal.model.Servico</class>

        <!-- Propriedades de conexao -->
        <properties>
            <!-- Conexao PostgreSQL -->
            <!-- Driver JDBC do PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <!-- URL de conexao ao banco de dados -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:3006/detetizadora_master"/>
            <!-- Credenciais de acesso ao banco -->
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="asdwsad"/>

            <!-- Configuracao Hibernate -->
            <!-- Configuracao Hibernate -->
            <!-- Usa 'update' para criar/atualizar tabelas conforme necessário -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- Exibe as consultas SQL geradas pelo Hibernate no console -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>

            <!-- Configuracao Flyway -->
            <property name="flyway.validateOnMigrate" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
