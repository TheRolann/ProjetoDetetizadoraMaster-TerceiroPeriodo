<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="detetizadora_master" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.edu.uniamerica.projetomensal.model.Cliente</class>
        <class>br.edu.uniamerica.projetomensal.model.Funcionario</class>
        <class>br.edu.uniamerica.projetomensal.model.Servico</class>
        <class>br.edu.uniamerica.projetomensal.model.Agenda</class>

        <!-- Conexão fornecida por DB_URL, DB_USER e DB_PASSWORD em BancoConfig. -->
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Flyway cuida do schema, Hibernate so valida que bate com o que o JPA espera -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
